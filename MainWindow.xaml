<Window x:Class="SeraphicSense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SeraphicSense"
        Height="500"
        Width="920"
        MinHeight="470"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Observed Folder Path" />
        <TextBox x:Name="ObservedFolderTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="0,0,8,0"
                 VerticalContentAlignment="Center" />
        <Button x:Name="ObservedBrowseButton"
                Grid.Row="0"
                Grid.Column="2"
                Content="Browse..."
                Click="ObservedBrowseButton_Click" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Source Folder Path" />
        <TextBox x:Name="SourceFolderTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,0,8,0"
                 VerticalContentAlignment="Center" />
        <Button x:Name="SourceBrowseButton"
                Grid.Row="2"
                Grid.Column="2"
                Content="Browse..."
                Click="SourceBrowseButton_Click" />

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Required Base Name" />
        <TextBox x:Name="RequiredBaseNameTextBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Required Extensions" />
        <TextBox x:Name="RequiredExtensionsTextBox"
                 Grid.Row="6"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center"
                 ToolTip="Comma separated: pak, sig, ucas, utoc" />

        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Forbidden Base Name" />
        <TextBox x:Name="ForbiddenBaseNameTextBox"
                 Grid.Row="8"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="10"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="Validation Delay (ms)" />
        <TextBox x:Name="ValidationDelayTextBox"
                 Grid.Row="10"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center"
                 ToolTip="Delay after file create/delete/rename before running validation. Default: 2000" />

        <TextBlock Grid.Row="12"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Text="GitHub Repository" />
        <TextBox x:Name="GitHubRepositoryTextBox"
                 Grid.Row="12"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center"
                 ToolTip="owner/repo (for update checks)" />

        <WrapPanel Grid.Row="14"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Orientation="Horizontal"
                   ItemHeight="28"
                   ItemWidth="220">
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Margin="0,0,8,0" />
            <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray" Margin="0,0,8,0" />
            <CheckBox x:Name="AutoStartMonitoringCheckBox" Content="Start monitoring on launch" Margin="0,0,8,0" />
            <CheckBox x:Name="CheckUpdatesOnLaunchCheckBox" Content="Check updates on launch" />
        </WrapPanel>

        <WrapPanel Grid.Row="16"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Orientation="Horizontal">
            <Button x:Name="StartStopButton"
                    Width="140"
                    Margin="0,0,8,0"
                    Content="Start Monitoring"
                    Click="StartStopButton_Click" />
            <Button x:Name="SaveSettingsButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Content="Save Settings"
                    Click="SaveSettingsButton_Click" />
            <Button x:Name="CheckUpdatesButton"
                    Width="120"
                    Content="Check Updates"
                    Click="CheckUpdatesButton_Click" />
        </WrapPanel>

        <Border Grid.Row="18"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Padding="10"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap"
                       Text="Status: Idle" />
        </Border>
    </Grid>
</Window>
